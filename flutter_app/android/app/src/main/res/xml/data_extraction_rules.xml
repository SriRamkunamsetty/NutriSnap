<?xml version="1.0" encoding="utf-8"?>
<!-- NutriSnap keeps health data on-device only: exclude everything from cloud
     backup and device-to-device transfer. Users move data with Settings >
     Data & privacy > Export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
